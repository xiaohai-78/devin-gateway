# 复制为 .env（make token / scripts/token-*.{sh,ps1} 会帮你写）。.env 已 gitignore，别提交。
# 注意：token 值必须用单引号包住，避免 Compose 把 $ 当变量展开。
# 改完后用 docker compose up -d 让新值生效（docker compose restart 不会重新读取 .env）。
DEVIN_TOKEN='devin-session-token$REPLACE_ME'

# 宿主机端口（只绑 127.0.0.1）。只对 Docker Compose 生效；二进制改端口用 SERVER_LISTEN
PORT=18089

# 可选：给 /v1/* 加鉴权。留空则免鉴权——只在默认的「仅本机」监听下这样用。
# 开放给局域网前必须设置；make smoke 会自动读这个值。
AUTH_API_KEY=

# 可选：预构建镜像地址（用 make up-image / docker compose up 时读取）
# GATEWAY_IMAGE=ghcr.io/xiaohai-78/devin-gateway:latest
