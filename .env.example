# 复制为 .env（make token 会帮你写）
# 注意：token 值必须用单引号包住，避免 Compose 把 $ 当变量展开
DEVIN_TOKEN='devin-session-token$REPLACE_ME'

# 宿主机端口（只绑 127.0.0.1）
PORT=18089

# 可选：给 /v1/* 加鉴权。留空则本机免鉴权
AUTH_API_KEY=

# 可选：预构建镜像地址（用 make up-image / docker compose up 时读取）
# GATEWAY_IMAGE=ghcr.io/xiaohai-78/devin-gateway:latest
